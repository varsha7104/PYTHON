# pkg-config file generated by gen-pkgconfig
# vile:makemode

prefix=/workspaces/PYTHON/venv
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include/ncursesw
abi_version=6
major_version=6
version=6.6.20251230

Name: panelw
Description: ncurses 6.6 add-on library
Version: ${version}
URL: https://invisible-island.net/ncurses
Requires.private: ncursesw
Libs:  -L/workspaces/PYTHON/venv/lib -Wl,-O2 -Wl,--sort-common -Wl,--disable-new-dtags -Wl,--gc-sections -Wl,-rpath,/workspaces/PYTHON/venv/lib -Wl,-rpath-link,/workspaces/PYTHON/venv/lib -lpanelw
Libs.private:  
Cflags:  -D_DEFAULT_SOURCE -D_XOPEN_SOURCE=600 -I${includedir} -I/workspaces/PYTHON/venv/include
